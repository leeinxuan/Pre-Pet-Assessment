// 飼養意願量表（前後測相同，1–10 分）
function comboIntentQuestions() {
  return [
    '我有信心能給予牠適當的日常照顧',
    '我願意為了飼養牠調整我的生活習慣與開支',
    '我認為飼養寵物需要認真準備，不能隨興而為',
    '如果決定領養，我會主動學習知識並準備好環境再帶回家'
  ];
}

// SUS 10 題（第 9 題依會議決議改寫，其餘為中文常用譯法）
const COMBO_SUS = [
  '我想我會願意經常使用這個網站',
  '我覺得這個網站過於複雜',
  '我覺得這個網站很容易使用',
  '我想我需要技術人員的協助才能使用這個網站',
  '我覺得這個網站中的各項功能整合得很好',
  '我覺得這個網站中有太多不一致的地方',
  '我想大多數人能很快學會使用這個網站',
  '我覺得這個網站使用起來非常不方便',
  '我很有信心能操作這個網站的所有功能',
  '我需要先學習很多東西，才能開始使用這個網站'
];

function comboAddIntentScale_(form) {
  form.addSectionHeaderItem()
    .setTitle('請依照您目前的想法，選擇最符合的程度')
    .setHelpText('1 = 非常不同意，10 = 非常同意。');
  comboIntentQuestions().forEach(function (text, i) {
    const item = form.addScaleItem()
      .setTitle(text)
      .setBounds(1, 10)
      .setLabels('非常不同意', '非常同意')
      .setRequired(true);
    if (i === 0) item.setHelpText('分數越高，代表飼養意願越高');
  });
}

function createCombinedForm() {
  const form = FormApp.create('「伴日子新手村」操作前後問卷');
  form.setIsQuiz(true);

  form.setDescription(
    '您好，感謝您參與本研究！\n' +
    '本研究想了解潛在飼主在飼養前，使用互動網頁後，對寵物照護知識與準備程度的變化。\n\n' +
    '📍整體流程（約 30 分鐘，全程在這一份問卷中進行，操作網站的階段除外）\n' +
    '第一階段：操作前作答（約 5 分鐘）\n' +
    '　選擇您打算飼養的物種，回答飼養意願與該物種的飼養知識題。\n' +
    '第二階段：操作網站（約 10–15 分鐘）\n' +
    '　問卷會提示您開啟「伴日子新手村」（連結已寄到您的 Email），完成後回到本問卷。使用過程會由後台自動記錄與錄影（您不需要自行錄影），資料僅供分析（去識別化後使用）。\n' +
    '第三階段：操作後作答（約 10 分鐘）\n' +
    '　再次回答飼養意願與知識題，並填寫網站使用感受與整體回饋。\n\n' +
    '📝作答說明\n' +
    '・這不是考試，不計成績，請依照您目前的想法作答，不需要查資料。\n' +
    '・請使用電腦或手機操作網站，自己一人完成。\n' +
    '・三個階段都完成後，才會寄送電子禮券。'
  );
  form.setProgressBar(true);
  form.setCollectEmail(false);
  form.setShuffleQuestions(false);
  form.setAllowResponseEdits(false);
  form.setConfirmationMessage(
    '感謝您參與本次「伴日子新手村」的實驗！\n' +
    '您的問卷已送出，可以查看第三階段知識題的答案與對應的網站頁面。\n' +
    '全部完成後，請跟研究者回報一聲，我們會盡快寄送電子禮券到您報名時填寫的 Email。\n\n' +
    '祝福您未來與寵物夥伴相處愉快、平安健康，每一天都有好多溫暖的小日子！'
  );

  // ----- 第 1 頁：受測者編號 -----
  form.addSectionHeaderItem().setTitle('受測者資料');
  form.addTextItem()
    .setTitle('受測者編號')
    .setHelpText('請填寫研究者提供的編號，例如 A03')
    .setRequired(true);

  // ===== 第一階段：操作前 =====
  form.addPageBreakItem()
    .setTitle('第一階段｜操作前：飼養想法')
    .setHelpText('請先選擇您打算飼養的物種，接下來的題目中「這隻寵物」都是指您選的這一種。\n請選擇與報名時相同的物種，之後操作網站時也要選同一種。');

  const preSpeciesItem = form.addListItem()
    .setTitle('您打算飼養的物種是？')
    .setHelpText('請選擇您報名時填寫的物種，之後操作「伴日子新手村」網站時也要選擇同一種，請務必保持一致。')
    .setRequired(true);

  comboAddIntentScale_(form);

  // ----- 前測知識題（不設答案、不計分） -----
  const preBreaks = [];
  COMBO_SPECIES.forEach(function (sp) {
    const pb = form.addPageBreakItem()
      .setTitle(COMBO_EMOJI[sp.name] + sp.name + '｜操作前知識題')
      .setHelpText(
        '接下來是 10 題關於照顧' + COMBO_CALL[sp.name] + '的小測驗，用來了解您目前對這些照顧知識的熟悉程度。\n' +
        '不用擔心答錯，結果只用於研究分析，不影響電子禮券。\n' +
        '請憑您現在的認知作答，不需要查資料；不確定時，選最接近的即可。'
      );
    preBreaks.push(pb);
    sp.questions.forEach(function (item, i) {
      form.addMultipleChoiceItem()
        .setTitle('Q' + (i + 1) + '. ' + item.q)
        .setChoiceValues(item.opts)
        .setRequired(true);
    });
  });

  // ===== 操作網站 =====
  const webPage = form.addPageBreakItem()
    .setTitle('接下來請操作網站')
    .setHelpText(
      '第一階段完成了！請依照研究者在 Email 提供的連結，開啟「伴日子新手村」網站並完成操作（約 10–15 分鐘）。\n\n' +
      '・在網站上請選擇與第一階段相同的物種。\n' +
      '・請保留這個表單分頁不要關閉，否則進度可能不見。操作完成後，回到這裡按「下一頁」，繼續第三階段。'
    );

  // ===== 第三階段：操作後 =====
  form.addPageBreakItem()
    .setTitle('第三階段｜操作後：飼養想法')
    .setHelpText('請先選擇與第一階段相同的物種，接下來的題目中「這隻寵物」都是指您選的這一種。');

  const postSpeciesItem = form.addListItem()
    .setTitle('請選擇與第一階段相同的物種')
    .setHelpText('選擇後，做完本頁會出現該物種的知識題')
    .setRequired(true);

  comboAddIntentScale_(form);

  // ----- 後測知識題（測驗模式，每題 1 分；題目與前測相同、順序不同） -----
  const postBreaks = [];
  COMBO_SPECIES.forEach(function (sp) {
    const pb = form.addPageBreakItem()
      .setTitle(COMBO_EMOJI[sp.name] + sp.name + '｜操作後知識題')
      .setHelpText(
        '接下來是 10 題關於照顧' + COMBO_CALL[sp.name] + '的小測驗，題目內容和第一階段相同、順序不同，用來了解您使用網站後的收穫。\n' +
        '不用擔心答錯，結果只用於研究分析，不影響電子禮券。\n' +
        '請憑您現在的認知作答，不需要查資料；不確定時，選最接近的即可。'
      );
    postBreaks.push(pb);
    COMBO_POST_ORDER.forEach(function (originalIndex, position) {
      const item = sp.questions[originalIndex];
      const mc = form.addMultipleChoiceItem();
      mc.setTitle('Q' + (position + 1) + '. ' + item.q)
        .setChoices(item.opts.map(function (text, k) {
          return mc.createChoice(text, k === item.a);
        }))
        .setPoints(1)
        .setRequired(true);
      const correctText = '正確答案：' + 'ABCD'.charAt(item.a) + '. ' + item.opts[item.a];
      mc.setFeedbackForCorrect(FormApp.createFeedback().setText(correctText + '\n' + item.note).build());
      mc.setFeedbackForIncorrect(FormApp.createFeedback().setText(correctText + '\n' + item.note).build());
    });
  });

  // ===== 共用：網站使用感受（SUS） =====
  const susPage = form.addPageBreakItem()
    .setTitle('網站使用感受')
    .setHelpText('請依照您剛才操作「伴日子新手村」的感受作答（1 = 非常不同意，5 = 非常同意）。');

  COMBO_SUS.forEach(function (text) {
    form.addScaleItem()
      .setTitle(text)
      .setBounds(1, 5)
      .setLabels('非常不同意', '非常同意')
      .setRequired(true);
  });

  // ===== 共用：整體回饋 =====
  form.addPageBreakItem().setTitle('整體回饋');

  form.addScaleItem()
    .setTitle('整體而言，我對「伴日子新手村」的體驗感到滿意')
    .setBounds(1, 5)
    .setLabels('非常不同意', '非常同意')
    .setRequired(true);

  form.addScaleItem()
    .setTitle('使用這個網站之後，我對照顧這隻寵物更有信心')
    .setBounds(1, 5)
    .setLabels('非常不同意', '非常同意')
    .setRequired(true);

  form.addScaleItem()
    .setTitle('我會想要把這個網站推薦給朋友')
    .setBounds(1, 5)
    .setLabels('非常不同意', '非常同意')
    .setRequired(true);

  form.addCheckboxItem()
    .setTitle('哪些部分對您幫助最大？（可複選）')
    .setChoiceValues([
      '飼養前準備（家庭與居住確認、佈置生活空間、出發前準備）',
      '飼養生活（接回家、日常照護、生活變化）',
      '飼養觀念回顧',
      '取得寵物',
      '都沒有特別幫助'
    ])
    .setRequired(true);

  form.addParagraphTextItem()
    .setTitle('對於這個網站，您還有什麼想法想告訴我們嗎？')
    .setHelpText('例如印象深刻的地方、覺得困惑的地方、希望改進的地方，或其他任何意見（非必填）')
    .setRequired(false);

  // ===== 跳頁設定 =====
  // 頁面分隔設定的「做完上一頁後要去哪」：
  // 前測：第二個物種之後的分頁，負責把前一個物種的知識題接到「操作網站」頁
  preBreaks.forEach(function (pb, idx) {
    if (idx > 0) pb.setGoToPage(webPage);
  });
  // 後測：第二個物種之後的分頁，負責把前一個物種的知識題接到 SUS 頁
  postBreaks.forEach(function (pb, idx) {
    if (idx > 0) pb.setGoToPage(susPage);
  });

  // 物種選單：每個選項跳到該物種的第一頁
  preSpeciesItem.setChoices(
    COMBO_SPECIES.map(function (sp, idx) { return preSpeciesItem.createChoice(sp.name, preBreaks[idx]); })
  );
  postSpeciesItem.setChoices(
    COMBO_SPECIES.map(function (sp, idx) { return postSpeciesItem.createChoice(sp.name, postBreaks[idx]); })
  );

  Logger.log('合併表單已建立');
  Logger.log('編輯連結：' + form.getEditUrl());
  Logger.log('填答連結：' + form.getPublishedUrl());
}
